{
  "name": "ariya",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @ariya/web dev",
    "build": "pnpm --filter @ariya/web build",
    "start": "pnpm --filter @ariya/web start",
    "analyze": "pnpm --filter @ariya/web analyze",
    "lint": "pnpm --filter @ariya/web lint",
    "typecheck": "pnpm --filter @ariya/web typecheck",
    "test": "pnpm --filter @ariya/web test",
    "test:watch": "pnpm --filter @ariya/web test:watch",
    "test:e2e": "pnpm --filter @ariya/web test:e2e",
    "build:wasm": "pnpm --filter @ariya/web build:wasm",
    "check:bundle": "pnpm --filter @ariya/web check:bundle",
    "db:types": "pnpm --filter @ariya/web db:types",
    "db:seed": "pnpm --filter @ariya/web db:seed",
    "test:rust": "cargo test --workspace",
    "test:db": "supabase test db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.0.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.4.2",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
